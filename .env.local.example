# Copy this file to .env.local for local development and fill in your
# Supabase project's values (Project Settings -> API in the Supabase
# dashboard). Never commit .env.local — it's already in .gitignore.
#
# For production on Vercel, set these same 3 variables in
# Project Settings -> Environment Variables instead of committing a file.
# See README.md ("Deploying to Vercel") and the Deployment Guide for details.
#
# This is the complete list — the app reads exactly these 3 variables and
# nothing else (verified against every `process.env` reference in the code).

# Public — safe to expose to the browser. Used by lib/supabase/client.ts,
# lib/supabase/server.ts, and lib/supabase/middleware.ts.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never prefixed with NEXT_PUBLIC_, never sent to the browser,
# and never read by the running app itself (the app always runs as the
# signed-in user, under Row Level Security). Only needed on your own machine
# if you run a script that must bypass RLS with elevated privileges — this
# codebase doesn't currently have one, but it's documented here so the value
# is never confused with the anon key above. Do not set this in Vercel unless
# you add such a script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
